{
  "name": "visionguard-web",
  "version": "1.0.0",
  "description": "Sistema de vigilancia inteligente: detección de personas en tiempo real, alarma y dashboard web.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev:node": "nodemon --watch src src/app.js",
    "dev:python": "cd vision-service && python main.py",
    "dev": "concurrently -n NODE,PYTHON -c green,cyan \"npm run dev:node\" \"npm run dev:python\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "session-file-store": "^1.5.0",
    "socket.io": "^4.7.5",
    "winston": "^3.14.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
