# --- Node.js backend ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=cambia_este_valor_por_uno_seguro

# --- Microservicio Python (IA) ---
PYTHON_SERVICE_URL=http://localhost:8001
PYTHON_WS_URL=ws://localhost:8001/ws/detections

# --- Cámara por defecto (opcional, se puede agregar desde el dashboard) ---
CAMERA_ID=cam-01
CAMERA_URL=rtsp://usuario:clave@192.168.1.50:554/Streaming/Channels/101

# --- Alarma / detección ---
ALARM_COOLDOWN=15
PERSON_THRESHOLD=1
TTS_VOICE=local
# Milisegundos que una persona debe permanecer dentro de la zona vigilada
# antes de disparar la alarma (evita falsas alarmas por alguien que solo
# pasa por el cuadro). 0 = disparo inmediato (comportamiento previo).
DWELL_MS=0
