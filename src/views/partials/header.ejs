<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'VisionGuard' %></title>
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/dashboard.css" />
  <script>
    // Aplica el tema guardado ANTES de pintar la página, para evitar el
    // parpadeo de un tema al cargar y cambiar al otro un instante después.
    (function () {
      try {
        var saved = localStorage.getItem('visionguard-theme');
        document.documentElement.setAttribute('data-theme', saved === 'dark' ? 'dark' : 'light');
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <div class="app-shell">
